# Copy to repo root .env or export before: go run ./cmd/api-gateway
# Gateway listens on GATEWAY_PORT; in docker-compose only this port is published to the host.

# Gateway
GATEWAY_PORT=8000
SHUTDOWN_TIMEOUT=10s
HEALTH_CHECK_TIMEOUT=3s

# Auth (shared secret — must match all services)
JWT_SECRET=your-secret-here

# Upstream service URLs (docker-compose internal DNS)
AUTH_SERVICE_URL=http://auth:8080
USERS_SERVICE_URL=http://users:8081
COURSES_SERVICE_URL=http://courses:8082
AVAILABILITY_SERVICE_URL=http://availability:8083
MATCHING_SERVICE_URL=http://matching:8084
GROUPS_SERVICE_URL=http://groups:8085
REVIEWS_SERVICE_URL=http://reviews:8086
POINTS_SERVICE_URL=http://points:8087

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate limiting (in-memory per gateway instance; resets on restart)
RATE_LIMIT_RPM=100
RATE_LIMIT_AUTH_RPM=20

# Google Calendar — set on availability service (not gateway)
# GCAL_REDIRECT_URL=http://localhost:8000/api/v1/availability/gcal/callback
